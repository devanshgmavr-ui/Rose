*.db
*.sqlite
*.sqlite3

# Outputs
outputs/*
!outputs/.gitkeep

# Sandbox
sandbox/*
!sandbox/.gitkeep

# Sessions
sessions/
*.session
*.session.json

# Workspace (generated content)
workspace/
