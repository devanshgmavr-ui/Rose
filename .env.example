# Rose Configuration
# Copy this file to .env and adjust values for your environment.
# Do NOT commit .env to version control.

# Model Configuration
# Qwen2.5-VL-7B-Instruct (Vision-Language model)
MODEL_PATH=./models/Qwen_Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
MODEL_NAME=qwen2.5-vl-7b-instruct
MODEL_CONTEXT_LENGTH=4096
MMPROJ_PATH=./models/mmproj-Qwen_Qwen2.5-VL-7B-Instruct-f16.gguf

# LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_GPU_LAYERS=28
LLM_VERBOSE=false

# Server Settings (for future API)
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log

# Paths
DATA_DIR=./data
OUTPUT_DIR=./outputs
MODEL_DIR=./models

# Orchestration Settings
MAX_PLAN_STEPS=12
MAX_TOOL_CALLS=20
MAX_REPLANS=3
MAX_STEP_RETRIES=2
MAX_TASK_DURATION=300

# Media Settings
MEDIA_MAX_IMAGE_SIZE=20971520
MEDIA_MAX_VIDEO_SIZE=104857600
MEDIA_TEMP_MAX_AGE=3600

# OS Control Settings
OS_CONTROL_ENABLED=true
SCREEN_CAPTURE_ENABLED=true
MAX_SCREEN_WIDTH=4096
MAX_SCREEN_HEIGHT=4096
MAX_SCREENSHOT_SIZE_MB=20
SYSTEM_INFO_ENABLED=true
MOUSE_CONTROL_ENABLED=false
KEYBOARD_CONTROL_ENABLED=false
WINDOW_CONTROL_ENABLED=false
WINDOW_CLOSE_ENABLED=false
WINDOW_MOVE_ENABLED=false
WINDOW_RESIZE_ENABLED=false
MIN_WINDOW_WIDTH=100
MIN_WINDOW_HEIGHT=100
MAX_WINDOW_WIDTH=4096
MAX_WINDOW_HEIGHT=4096
MAX_MOUSE_ACTIONS_PER_REQUEST=20
MAX_KEYBOARD_ACTIONS_PER_REQUEST=20
MAX_TYPED_TEXT_LENGTH=1000
MOUSE_ACTION_TIMEOUT=5
KEYBOARD_ACTION_TIMEOUT=5
MAX_SCROLL_AMOUNT=10

# Browser Automation Settings
BROWSER_AUTOMATION_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_MAX_SESSIONS=2
BROWSER_MAX_TABS=5
BROWSER_NAVIGATION_TIMEOUT=30000
BROWSER_ACTION_TIMEOUT=10000
BROWSER_MAX_PAGE_TEXT_CHARS=20000
BROWSER_MAX_PAGE_TEXT_TOKENS=5000
BROWSER_MAX_ELEMENTS_RETURNED=100
BROWSER_MAX_INPUT_TEXT_LENGTH=2000
BROWSER_INTERACTION_TIMEOUT=10000
BROWSER_MAX_INTERACTIONS_PER_REQUEST=20
BROWSER_MAX_WAIT_TIMEOUT=15000
# Browser screenshot settings (requires BROWSER_AUTOMATION_ENABLED=true)
BROWSER_SCREENSHOT_ENABLED=false
BROWSER_MAX_SCREENSHOT_WIDTH=3840
BROWSER_MAX_SCREENSHOT_HEIGHT=2160
BROWSER_MAX_FULL_PAGE_HEIGHT=10000
BROWSER_MAX_SCREENSHOT_SIZE_MB=20
BROWSER_MAX_SCREENSHOTS_PER_REQUEST=10
BROWSER_SCREENSHOT_TIMEOUT=10000
# Window mutations (activate, minimize, restore, maximize) require confirmation

# Vision Settings
VISION_ENABLED=false
VISION_PROVIDER=local
VISION_MODEL_PATH=
VISION_MAX_IMAGE_SIZE_MB=20
VISION_MAX_IMAGE_WIDTH=4096
VISION_MAX_IMAGE_HEIGHT=4096
VISION_MAX_ELEMENTS=100
VISION_ANALYSIS_TIMEOUT=30000
